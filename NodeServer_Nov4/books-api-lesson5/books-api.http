@baseUrl = http://localhost:3002/api

### 1. GET all books -- expect 200
GET {{baseUrl}}/books

### 2. GET one book by id -- expect 200
GET {{baseUrl}}/books/1

### 3. GET a book that does not exist -- expect 404
GET {{baseUrl}}/books/9999

### 4. Search by title -- expect 200
GET {{baseUrl}}/books/search/the

### 5. POST -- create a new book -- expect 201 (note the id it returns)
POST {{baseUrl}}/books
Content-Type: application/json

{
  "id": 1,
  "title": "Mwahahaha",
  "pages": 800,
  "author": "Evil Mastermind",
  "year": 2100,
  "num_sold": 750000000
}

### 6. PUT -- update the book you just created -- replace 15 with YOUR id from step 5
PUT {{baseUrl}}/books/15
Content-Type: application/json

{
  "title": "The Alchemist",
  "pages": 197,
  "author": "Coelho",
  "year": 1988,
  "num_sold": 200
}

### 7. DELETE -- remove YOUR book -- replace 15 with your id
DELETE {{baseUrl}}/books/15

### 8. Confirm the delete -- expect 404
GET {{baseUrl}}/books/15

### 9. POST missing required field -- expect 400
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "Incomplete Book"
}
